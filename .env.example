# PetMonitor AI — environment variables
# Copy to .env (never commit .env)

# --- Blink credentials ---
BLINK_USERNAME=your_email@example.com
BLINK_PASSWORD=your_blink_password

# --- Local storage paths (defaults shown; override if needed) ---
# PETMONITOR_DATA_DIR=data
# PETMONITOR_DB_PATH=data/petmonitor.db
# PETMONITOR_CLIPS_DIR=data/clips
# PETMONITOR_SNAPSHOTS_DIR=data/snapshots

# --- Detection settings (defaults in configs/app.yaml; override here if desired) ---
# PETMONITOR_CONFIDENCE_THRESHOLD=0.4
# PETMONITOR_FRAME_SAMPLE_RATE=5

# --- API settings ---
# PETMONITOR_API_HOST=127.0.0.1
# PETMONITOR_API_PORT=8000
